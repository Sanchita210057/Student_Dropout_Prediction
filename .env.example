# Local Django development. Keep real secrets and database credentials out of Git.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
INSTITUTE_NAME=Student Support Institute

# SQLite defaults to ~/.student_dropout/db.sqlite3, outside the source tree.
# Set DJANGO_SQLITE_PATH or DJANGO_LOCAL_DATA_DIR to override it.
# For PythonAnywhere/MySQL set DJANGO_DB_ENGINE=mysql and fill in the DB fields
# privately in the hosting environment.
DJANGO_DB_ENGINE=sqlite
DJANGO_SQLITE_PATH=
DJANGO_LOCAL_DATA_DIR=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306
DJANGO_CACHE_TABLE=django_cache_table
